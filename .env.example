# Optional. Everything works with no .env file — api/upload.js and api/maximo.js
# carry the working hosts and credentials. Copy this to .env.local only when you
# need to point somewhere else.
#
# .env.local is gitignored. Never commit real credentials.

# --- digitiser (api/upload.js) ---
# DIGITISE_BASE_URL=https://dev-mms.eam360.com/digitiser
# Drop the /mock segment to hit the real endpoint:
# DIGITISE_PATH=/api/v1/form-digitisation/upload?target_format=maximo
# DIGITISE_API_KEY=

# --- Maximo (api/maximo.js) ---
# MAXIMO_BASE_URL=https://demo.eam360.com/maxrest
# base64 of "user:password"
# MAXIMO_MAXAUTH=
# If set, sent as APIKEY instead of maxauth:
# MAXIMO_APIKEY=
# Only if Maximo needs a session cookie. Browsers cannot send this; the proxy can.
# MAXIMO_COOKIE=JSESSIONIDUIMANAGE=...

# --- both ---
# UPSTREAM_TIMEOUT_MS=120000

# --- server ---
# PORT=3000
